# 🔶 PASTE FIREBASE CONFIG HERE
# Firebase Web App configuration from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# 🔶 GOOGLE IDENTITY SERVICES (GIS)
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# 🔶 ADMIN IDENTITY CONFIGURATION
# Initial Admin Firebase Auth UID and authorized admin email
VITE_INITIAL_ADMIN_UID="your-firebase-auth-uid"
VITE_INITIAL_ADMIN_EMAIL="admin@example.com"
